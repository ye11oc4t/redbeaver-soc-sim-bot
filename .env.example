# redbeaver — active-safe SOC validation bot
# Copy this file to .env and edit only what you need.

# ---- Run identity ----
REDBEAVER_RUN_ID=local-run
EXECUTION_ZONE=external
RESULTS_DIR=results
WORKDIR=.redbeaver-work

# ---- Discord notification ----
DISCORD_WEBHOOK_URL=

# ---- Safety gates: all false by default ----
ENABLE_NETWORK=false
ENABLE_AWS_READONLY=false
ENABLE_S3_MARKER=false
ENABLE_DB_READONLY=false
ENABLE_UPLOAD_MARKER=false
ENABLE_AUTH_MARKER=false
ENABLE_PACU=false

# ---- Edge / Web target ----
TARGET_BASE_URL=https://example.invalid
TARGET_ENDPOINTS=/,/health,/api/products,/api/login,/api/orders,/admin
UPLOAD_ENDPOINT=/api/upload
LOGIN_ENDPOINT=/api/login

# Safe caps. Hard-capped in code as well.
HTTP_TOTAL_REQUESTS=20
HTTP_CONCURRENCY=3
HTTP_TIMEOUT=4
AUTH_MAX_ATTEMPTS=12

# ---- C2 marker target ----
# Set this to your own harmless collector endpoint.
C2_COLLECTOR_URL=http://127.0.0.1:8080/beacon
C2_DOMAIN=example.invalid
C2_BEACONS=5
C2_INTERVAL_SECONDS=5

# ---- DB read-only marker ----
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ---- S3 marker bucket: must be your own bucket ----
MARKER_BUCKET=
MARKER_PREFIX=redbeaver/markers

# ---- Pacu read-only wrapper ----
PACU_BINARY=pacu
PACU_SESSION_NAME=redbeaver-safe
PACU_MODULES=aws__enum_account,iam__enum_permissions,ec2__enum
PACU_TIMEOUT_SECONDS=180
